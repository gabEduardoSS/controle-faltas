{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "types": [
      "node"
    ]
  },
  "exclude": [
    "dist"
  ],
  "ts-node": {
    "compilerOptions": {
      "module": "nodenext",
      "moduleResolution": "node16"
    }
  }
}